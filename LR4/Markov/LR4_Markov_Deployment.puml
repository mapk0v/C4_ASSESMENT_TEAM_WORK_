@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()
title Диаграмма развертывания (C4 L2) — инфраструктура API Gateway & Backend

Deployment_Node(client, "Клиентское устройство", "Браузер / Смартфон") {
    Container(web_app, "Веб-приложение / Мобильное приложение", "React / React Native", "Интерфейс пользователя")
}

Deployment_Node(cloud, "Облачная инфраструктура (ЦОД)", "Yandex Cloud / AWS") {
    
    Deployment_Node(nginx_node, "Сервер веб-сервисов", "Ubuntu Linux VM (публичный IP)") {
        Container(nginx, "Reverse Proxy & Load Balancer", "Nginx", "SSL-терминация, балансировка нагрузки между экземплярами бэкенда")
    }
    
    Deployment_Node(app_node_1, "Сервер приложений #1", "Ubuntu Linux (Docker Host)") {
        Container(backend_1, "API Gateway (Экземпляр 1)", "Python / FastAPI", "Бизнес-логика (Docker-контейнер)")
    }

    Deployment_Node(app_node_2, "Сервер приложений #2", "Ubuntu Linux (Docker Host)") {
        Container(backend_2, "API Gateway (Экземпляр 2)", "Python / FastAPI", "Бизнес-логика (Docker-контейнер)")
    }
    
    Deployment_Node(db_node, "Сервер БД", "Managed PostgreSQL VM") {
        ContainerDb(db_master, "Центральная БД", "PostgreSQL 16", "Основные данные (запись/чтение)")
    }
}

Rel(client, nginx, "Запросы к API", "HTTPS / TLS 1.3, порт 443")
Rel(nginx, backend_1, "Балансировка нагрузки (50%)", "HTTP / JSON, порт 8000")
Rel(nginx, backend_2, "Балансировка нагрузки (50%)", "HTTP / JSON, порт 8000")
Rel(backend_1, db_master, "Запись и чтение", "SQL / TCP, порт 5432")
Rel(backend_2, db_master, "Запись и чтение", "SQL / TCP, порт 5432")

@enduml
