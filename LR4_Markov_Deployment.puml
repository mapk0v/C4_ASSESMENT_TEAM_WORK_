@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()
title Диаграмма развертывания (C4 L2) — инфраструктура API Gateway & Backend

Deployment_Node(client, "Клиентское устройство", "Браузер / Смартфон") {
    Container(web_app, "Веб-приложение / Мобильное приложение", "React / React Native", "Интерфейс пользователя")
}

Deployment_Node(cloud, "Облачная инфраструктура (ЦОД)", "Yandex Cloud / AWS") {
    Deployment_Node(nginx_node, "Сервер веб-сервисов", "Ubuntu Linux VM (публичный IP)") {
        Container(nginx, "Reverse Proxy", "Nginx", "SSL-терминация, балансировка")
    }
    
    Deployment_Node(app_node, "Сервер приложений", "Ubuntu Linux (Docker Host)") {
        Container(backend, "API Gateway & Backend", "Python / FastAPI", "Бизнес-логика (Docker-контейнер)")
    }
    
    Deployment_Node(db_node, "Сервер БД (Мастер)", "Managed PostgreSQL VM") {
        ContainerDb(db_master, "Центральная БД", "PostgreSQL 16", "Основные данные (запись/чтение)")
    }
    
    Deployment_Node(db_replica_node, "Сервер БД (Реплика)", "Managed PostgreSQL VM") {
        ContainerDb(db_replica, "Реплика БД", "PostgreSQL 16", "Горячий резерв, чтение")
    }
}

Rel(client, nginx, "Запросы к API", "HTTPS / TLS 1.3, порт 443")
Rel(nginx, backend, "Проксирование запросов", "HTTP / JSON, порт 8000")
Rel(backend, db_master, "Запись и чтение", "SQL / TCP, порт 5432")
Rel(db_master, db_replica, "Потоковая репликация (WAL)", "WAL / TCP, порт 5432")

@enduml
